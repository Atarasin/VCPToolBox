{
  "agents": {
    "Nexus": {
      "defaultProfile": "nexus-default",
      "allowedProfiles": ["nexus-default"],
      "targets": ["Nexus日记本"]
    },
    "Aemeath": {
      "defaultProfile": "aemeath-gated",
      "allowedProfiles": ["aemeath-gated", "aemeath-fulltext", "aemeath-gated-fulltext"],
      "targets": ["Aemeath日记本"]
    }
  },
  "profiles": {
    "nexus-default": {
      "merge": "concat",
      "aggregate": "max",
      "projection": "semantic",
      "tokenBudget": 1600,
      "maxTokenRatio": 0.7,
      "minScore": 0.2,
      "rules": [
        {
          "baseMode": "rag",
          "targets": { "diaries": ["Nexus日记本"], "kMultiplier": 1.5 },
          "modifiers": {
            "time": true,
            "group": true,
            "rerank": true,
            "tagMemo": true,
            "truncate": true
          }
        }
      ]
    },
    "aemeath-gated": {
      "merge": "interleave",
      "aggregate": "mean",
      "projection": "keyword",
      "tokenBudget": 1200,
      "maxTokenRatio": 0.6,
      "minScore": 0.35,
      "rules": [
        {
          "baseMode": "gated_rag",
          "targets": { "diaries": ["Aemeath日记本"], "kMultiplier": 2 },
          "gateThreshold": 0.35,
          "modifiers": {
            "time": false,
            "group": true,
            "rerank": false,
            "tagMemo": true,
            "truncate": true
          }
        }
      ]
    },
    "aemeath-fulltext": {
      "merge": "concat",
      "aggregate": "sum",
      "projection": "full",
      "tokenBudget": 2000,
      "maxTokenRatio": 0.8,
      "minScore": 0.1,
      "rules": [
        {
          "baseMode": "full_text",
          "targets": { "diaries": ["Aemeath日记本"] },
          "modifiers": {
            "timeDecay": true,
            "roleValve": true,
            "base64Memo": true,
            "truncate": true
          }
        }
      ]
    },
    "aemeath-gated-fulltext": {
      "merge": "interleave",
      "aggregate": "max",
      "projection": "hybrid",
      "tokenBudget": 1500,
      "maxTokenRatio": 0.7,
      "minScore": 0.35,
      "rules": [
        {
          "baseMode": "gated_full_text",
          "targets": { "diaries": ["Aemeath日记本"], "kMultiplier": 1.2 },
          "gateThreshold": 0.35,
          "modifiers": {
            "timeDecay": true,
            "roleValve": true,
            "base64Memo": true,
            "truncate": true
          }
        }
      ]
    }
  }
}
