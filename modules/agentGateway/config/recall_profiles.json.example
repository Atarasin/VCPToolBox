{
  "_comment": "Recall Profile 配置：每个 agent 可拥有多个 profile，每个 profile 包含一条或多条 recall rules",
  "agents": {
    "AgentName": {
      "defaultProfile": "profile-name",
      "profiles": {
        "profile-name": {
          "rules": [
            {
              "type": "rag",
              "diaries": ["DiaryName日记本"],
              "modifiers": {
                "time": true,
                "group": true,
                "rerank": true,
                "tagMemo": true,
                "truncate": true
              }
            }
          ]
        },
        "gated-profile": {
          "rules": [
            {
              "type": "gated_rag",
              "diaries": ["DiaryName日记本"],
              "gateThreshold": 0.35,
              "modifiers": {
                "time": false,
                "group": true,
                "rerank": false,
                "tagMemo": true,
                "truncate": true
              }
            }
          ]
        }
      }
    }
  }
}
