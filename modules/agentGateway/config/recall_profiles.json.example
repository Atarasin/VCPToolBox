{
  "_comment": "Recall Profile 配置：每个 agent 可拥有多个 profile，每个 profile 包含一条或多条 recall rules。\nstructured model（baseMode + targets.diaries + targets.kMultiplier）为首选格式。\n旧字段 type/diaries/kMultiplier 仍兼容但已弃用，运行时将输出 deprecation warning。",
  "agents": {
    "AgentName": {
      "defaultProfile": "profile-name",
      "allowedProfiles": ["profile-name", "gated-profile"],
      "targets": ["DiaryName日记本"]
    }
  },
  "profiles": {
    "profile-name": {
      "rules": [
        {
          "baseMode": "rag",
          "targets": {
            "diaries": ["DiaryName日记本"],
            "kMultiplier": 1.5
          },
          "modifiers": {
            "time": true,
            "group": true,
            "rerank": true,
            "tagMemo": true,
            "truncate": true
          }
        }
      ]
    },
    "gated-profile": {
      "rules": [
        {
          "baseMode": "gated_rag",
          "targets": {
            "diaries": ["DiaryName日记本"],
            "kMultiplier": 2.0
          },
          "gateThreshold": 0.35,
          "modifiers": {
            "time": false,
            "group": true,
            "rerank": false,
            "tagMemo": true,
            "truncate": true
          }
        }
      ]
    }
  }
}
