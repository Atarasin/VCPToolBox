{
  "_comment": "Recall Profile 配置：每个 agent 可拥有多个 profile，每个 profile 包含一条或多条 recall rules。\nstructured model（baseMode + targets.diaries + targets.kMultiplier）为首选格式。\n旧字段 type/diaries/kMultiplier 仍兼容但已弃用，运行时将输出 deprecation warning。",
  "agents": {
    "AgentName": {
      "defaultProfile": "profile-name",
      "allowedProfiles": ["profile-name", "gated-profile", "full-text-profile"],
      "targets": ["DiaryName日记本"]
    }
  },
  "profiles": {
    "profile-name": {
      "merge": "interleave",
      "aggregate": "max",
      "projection": "semantic",
      "truncateTo": 20,
      "tokenBudget": 1600,
      "maxTokenRatio": 0.7,
      "minScore": 0.2,
      "metadata": {
        "tier": "default"
      },
      "rules": [
        {
          "baseMode": "rag",
          "targets": {
            "diaries": ["DiaryName日记本"],
            "kMultiplier": 1.5
          },
          "modifiers": {
            "time": true,
            "group": true,
            "rerank": {
              "enabled": true,
              "weight": 0.5
            },
            "tagMemo": {
              "enabled": true,
              "weight": 1.0
            },
            "truncate": 20
          }
        }
      ]
    },
    "gated-profile": {
      "rules": [
        {
          "baseMode": "gated_rag",
          "targets": {
            "diaries": ["DiaryName日记本"],
            "kMultiplier": 2.0
          },
          "gateThreshold": 0.35,
          "modifiers": {
            "time": false,
            "group": true,
            "rerank": false,
            "tagMemo": true,
            "truncate": true
          }
        }
      ]
    },
    "full-text-profile": {
      "projection": "full",
      "tokenBudget": 2000,
      "maxTokenRatio": 0.8,
      "minScore": 0.1,
      "aiMemo": {
        "enabled": false,
        "preset": "concise"
      },
      "rules": [
        {
          "baseMode": "gated_full_text",
          "targets": {
            "diaries": ["DiaryName日记本"],
            "kMultiplier": 1.2
          },
          "gateThreshold": 0.35,
          "modifiers": {
            "timeDecay": true,
            "roleValve": {
              "roles": ["user"],
              "mode": "OR"
            },
            "base64Memo": false,
            "truncate": 20
          }
        }
      ]
    }
  }
}
