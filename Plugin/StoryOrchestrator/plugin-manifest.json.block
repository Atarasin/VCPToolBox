{
  "manifestVersion": "1.1.0",
  "name": "StoryOrchestrator",
  "version": "1.1.0",
  "displayName": "多智能体故事创作编排器",
  "description": "多智能体协作的短篇故事创作编排器，支持三阶段工作流、用户检查点确认、章节级生成/审查/修订/润色，以及恢复重试与导出闭环。",
  "author": "VCPToolBox",
  "pluginType": "hybridservice",
  "entryPoint": {
    "script": "core/StoryOrchestrator.js"
  },
  "communication": {
    "protocol": "direct",
    "timeout": 600000
  },
  "webSocketPush": {
    "enabled": true,
    "messageType": "story_orchestrator_notification"
  },
  "configSchema": {
    "ORCHESTRATOR_DEBUG_MODE": "boolean",
    "USE_WORKFLOW_KERNEL": "boolean",
    "WORKFLOW_HOT_RELOAD": "boolean",
    "QUALITY_THRESHOLD": "number",
    "MAX_PHASE_ITERATIONS": "integer",
    "DEFAULT_TARGET_WORD_COUNT_MIN": "integer",
    "DEFAULT_TARGET_WORD_COUNT_MAX": "integer",
    "USER_CHECKPOINT_TIMEOUT_MS": "integer",
    "STORY_STATE_RETENTION_DAYS": "integer",
    "AGENT_WORLD_BUILDER_MODEL_ID": "string",
    "AGENT_WORLD_BUILDER_CHINESE_NAME": "string",
    "AGENT_WORLD_BUILDER_SYSTEM_PROMPT": "string",
    "AGENT_WORLD_BUILDER_MAX_OUTPUT_TOKENS": "integer",
    "AGENT_WORLD_BUILDER_TEMPERATURE": "number",
    "AGENT_CHARACTER_DESIGNER_MODEL_ID": "string",
    "AGENT_CHARACTER_DESIGNER_CHINESE_NAME": "string",
    "AGENT_CHARACTER_DESIGNER_SYSTEM_PROMPT": "string",
    "AGENT_CHARACTER_DESIGNER_MAX_OUTPUT_TOKENS": "integer",
    "AGENT_CHARACTER_DESIGNER_TEMPERATURE": "number",
    "AGENT_PLOT_ARCHITECT_MODEL_ID": "string",
    "AGENT_PLOT_ARCHITECT_CHINESE_NAME": "string",
    "AGENT_PLOT_ARCHITECT_SYSTEM_PROMPT": "string",
    "AGENT_PLOT_ARCHITECT_MAX_OUTPUT_TOKENS": "integer",
    "AGENT_PLOT_ARCHITECT_TEMPERATURE": "number",
    "AGENT_CHAPTER_WRITER_MODEL_ID": "string",
    "AGENT_CHAPTER_WRITER_CHINESE_NAME": "string",
    "AGENT_CHAPTER_WRITER_SYSTEM_PROMPT": "string",
    "AGENT_CHAPTER_WRITER_MAX_OUTPUT_TOKENS": "integer",
    "AGENT_CHAPTER_WRITER_TEMPERATURE": "number",
    "AGENT_DETAIL_FILLER_MODEL_ID": "string",
    "AGENT_DETAIL_FILLER_CHINESE_NAME": "string",
    "AGENT_DETAIL_FILLER_SYSTEM_PROMPT": "string",
    "AGENT_DETAIL_FILLER_MAX_OUTPUT_TOKENS": "integer",
    "AGENT_DETAIL_FILLER_TEMPERATURE": "number",
    "AGENT_LOGIC_VALIDATOR_MODEL_ID": "string",
    "AGENT_LOGIC_VALIDATOR_CHINESE_NAME": "string",
    "AGENT_LOGIC_VALIDATOR_SYSTEM_PROMPT": "string",
    "AGENT_LOGIC_VALIDATOR_MAX_OUTPUT_TOKENS": "integer",
    "AGENT_LOGIC_VALIDATOR_TEMPERATURE": "number",
    "AGENT_STYLE_POLISHER_MODEL_ID": "string",
    "AGENT_STYLE_POLISHER_CHINESE_NAME": "string",
    "AGENT_STYLE_POLISHER_SYSTEM_PROMPT": "string",
    "AGENT_STYLE_POLISHER_MAX_OUTPUT_TOKENS": "integer",
    "AGENT_STYLE_POLISHER_TEMPERATURE": "number",
    "AGENT_FINAL_EDITOR_MODEL_ID": "string",
    "AGENT_FINAL_EDITOR_CHINESE_NAME": "string",
    "AGENT_FINAL_EDITOR_SYSTEM_PROMPT": "string",
    "AGENT_FINAL_EDITOR_MAX_OUTPUT_TOKENS": "integer",
    "AGENT_FINAL_EDITOR_TEMPERATURE": "number"
  },
  "capabilities": {
    "parameters": {
      "story_prompt": {
        "type": "string",
        "description": "故事项目的核心梗概或开篇设定，至少 10 个字符。"
      },
      "target_word_count": {
        "type": "integer",
        "description": "目标总字数或章节目标字数。启动项目时建议传入 500-50000 之间的整数。"
      },
      "genre": {
        "type": "string",
        "description": "故事类型/题材，例如科幻、悬疑、奇幻、现实向。"
      },
      "style_preference": {
        "type": "string",
        "description": "文风偏好或表达要求，例如硬科幻、第一人称、冷峻克制。"
      },
      "story_id": {
        "type": "string",
        "description": "故事项目唯一 ID，通常为 story- 开头，用于后续查询、恢复、导出与章节操作。"
      },
      "checkpoint_id": {
        "type": "string",
        "description": "待确认的检查点 ID，需与当前故事状态中的 active checkpoint 一致。"
      },
      "approval": {
        "type": "boolean",
        "description": "是否通过当前检查点。true 表示继续推进，false 表示驳回并结合 feedback 回流。"
      },
      "feedback": {
        "type": "string",
        "description": "对检查点审批、恢复或重试的补充反馈，可写明希望修改的问题与方向。"
      },
      "format": {
        "type": "string",
        "description": "导出格式。可选 markdown、txt、json，默认 markdown。"
      },
      "recovery_action": {
        "type": "string",
        "description": "恢复动作类型。可选 continue、restart_phase、rollback。"
      },
      "target_phase": {
        "type": "string",
        "description": "恢复目标阶段。可选 phase1、phase2、phase3。"
      },
      "target_checkpoint": {
        "type": "string",
        "description": "恢复时指定的目标检查点 ID。仅在需要精确恢复位置时提供。"
      },
      "phase_name": {
        "type": "string",
        "description": "需要手动重试的阶段名称。可选 phase1、phase2、phase3。"
      },
      "reason": {
        "type": "string",
        "description": "手动重试阶段的原因说明。"
      }
    },
    "invocationCommands": [
      {
        "commandIdentifier": "StartStoryProject",
        "description": "启动新的故事创作项目，创建 story_id 并立即进入第一阶段“世界观与人设搭建”。适用于从一个故事梗概开始完整跑通三阶段流程。",
        "parameters": [
          {
            "name": "story_prompt",
            "description": "故事梗概、开篇设定或创作任务说明，至少 10 个字符。",
            "required": true,
            "type": "string"
          },
          {
            "name": "target_word_count",
            "description": "目标总字数，建议传入 500-50000 之间的整数。不提供时使用插件默认范围。",
            "required": false,
            "type": "integer"
          },
          {
            "name": "genre",
            "description": "故事题材，例如科幻、悬疑、奇幻、都市。",
            "required": false,
            "type": "string"
          },
          {
            "name": "style_preference",
            "description": "文风偏好、叙事视角或语气要求。",
            "required": false,
            "type": "string"
          }
        ],
        "example": "<<<[TOOL_REQUEST]>>>\ntool_name:「始」StoryOrchestrator「末」,\ncommand:「始」StartStoryProject「末」,\nstory_prompt:「始」2045 年，第一批具备自我叙事能力的城市级 AI 被要求与人类共治，一名维护工程师发现其中一个 AI 正在悄悄重写自己的起源档案。请创作一个兼具悬疑与情感张力的近未来故事。「末」,\ntarget_word_count:「始」3200「末」,\ngenre:「始」科幻悬疑「末」,\nstyle_preference:「始」冷峻克制，注重细节铺垫与人物心理变化「末」\n<<<[END_TOOL_REQUEST]>>>"
      },
      {
        "commandIdentifier": "QueryStoryStatus",
        "description": "查询故事项目当前状态、阶段进度、检查点与工作流运行信息。适用于轮询异步推进结果或在用户确认前获取最新上下文。",
        "parameters": [
          {
            "name": "story_id",
            "description": "要查询的故事项目 ID。",
            "required": true,
            "type": "string"
          }
        ]
      },
      {
        "commandIdentifier": "UserConfirmCheckpoint",
        "description": "对当前检查点执行人工确认。批准后工作流继续，拒绝后会结合 feedback 进入回流修订。",
        "parameters": [
          {
            "name": "story_id",
            "description": "所属故事项目 ID。",
            "required": true,
            "type": "string"
          },
          {
            "name": "checkpoint_id",
            "description": "当前待确认的检查点 ID，需与故事状态中的 checkpoint_id 一致。",
            "required": true,
            "type": "string"
          },
          {
            "name": "approval",
            "description": "true 表示批准继续，false 表示驳回并回流。",
            "required": true,
            "type": "boolean"
          },
          {
            "name": "feedback",
            "description": "当 approval=false 时建议提供具体修改意见；approval=true 时可省略。",
            "required": false,
            "type": "string"
          }
        ],
        "example": "<<<[TOOL_REQUEST]>>>\ntool_name:「始」StoryOrchestrator「末」,\ncommand:「始」UserConfirmCheckpoint「末」,\nstory_id:「始」story-abc123def456「末」,\ncheckpoint_id:「始」cp-phase1-story-abc123def456-1712345678901「末」,\napproval:「始」false「末」,\nfeedback:「始」世界观结构已经清晰，但主角与城市级 AI 的利益冲突还不够尖锐，请强化二者在价值观上的对立，并补一条后续会引爆主线的伏笔。「末」\n<<<[END_TOOL_REQUEST]>>>"
      },
      {
        "commandIdentifier": "ExportStory",
        "description": "导出完整故事内容，适合在项目完成后输出 markdown、txt 或 json 版本。",
        "parameters": [
          {
            "name": "story_id",
            "description": "要导出的故事项目 ID。",
            "required": true,
            "type": "string"
          },
          {
            "name": "format",
            "description": "导出格式。可选 markdown、txt、json，默认 markdown。",
            "required": false,
            "type": "string"
          }
        ]
      },
      {
        "commandIdentifier": "RecoverStoryWorkflow",
        "description": "在工作流卡住、异常中断或需要人工干预时执行恢复。支持继续推进、重启某阶段或回滚到上一个有效节点。",
        "parameters": [
          {
            "name": "story_id",
            "description": "需要恢复的故事项目 ID。",
            "required": true,
            "type": "string"
          },
          {
            "name": "recovery_action",
            "description": "恢复动作。可选 continue、restart_phase、rollback；默认 continue。",
            "required": false,
            "type": "string"
          },
          {
            "name": "target_phase",
            "description": "当 recovery_action=restart_phase 时可指定 phase1、phase2、phase3。",
            "required": false,
            "type": "string"
          },
          {
            "name": "target_checkpoint",
            "description": "可选的目标检查点 ID，用于更精细的恢复定位。",
            "required": false,
            "type": "string"
          },
          {
            "name": "feedback",
            "description": "恢复时附带的原因说明或修正方向。",
            "required": false,
            "type": "string"
          }
        ],
        "example": "<<<[TOOL_REQUEST]>>>\ntool_name:「始」StoryOrchestrator「末」,\ncommand:「始」RecoverStoryWorkflow「末」,\nstory_id:「始」story-abc123def456「末」,\nrecovery_action:「始」restart_phase「末」,\ntarget_phase:「始」phase2「末」,\nfeedback:「始」第二阶段生成的大纲冲突较多，请从 Phase2 重新开始，并优先确保角色动机与主线事件因果闭合。「末」\n<<<[END_TOOL_REQUEST]>>>"
      },
      {
        "commandIdentifier": "RetryPhase",
        "description": "手动重试指定阶段，适用于阶段执行失败、结果不稳定或需要重新触发某一阶段时使用。",
        "parameters": [
          {
            "name": "story_id",
            "description": "所属故事项目 ID。",
            "required": true,
            "type": "string"
          },
          {
            "name": "phase_name",
            "description": "需要重试的阶段名称。可选 phase1、phase2、phase3。",
            "required": true,
            "type": "string"
          },
          {
            "name": "reason",
            "description": "触发手动重试的原因说明。",
            "required": false,
            "type": "string"
          }
        ]
      }
    ],
    "systemPromptPlaceholders": [
      {
        "placeholder": "{{StoryOrchestratorStatus}}",
        "description": "当前活跃的故事项目状态摘要",
        "isDynamic": true
      },
      {
        "placeholder": "{{StoryBible}}",
        "description": "当前故事的世界观和人物设定(故事圣经)",
        "isDynamic": true
      }
    ]
  }
}
