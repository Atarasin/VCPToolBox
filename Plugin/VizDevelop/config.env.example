# VizDevelop 插件配置模板
# 复制为 config.env 并填入真实值；config.env 不入库。

# 显影 MCP 端点。同机部署用默认值即可；
# 若 VCP 改为 Docker 运行，需换成宿主地址（容器内 127.0.0.1 不可达宿主服务）。
VIZ_DEVELOP_MCP_URL=http://127.0.0.1:8787/mcp

# Bearer 令牌（必填）：取自显影服务端 config/auth-token 文件的内容。
VIZ_DEVELOP_AUTH_TOKEN=替换为显影服务config/auth-token文件内容

# 付费生成/编辑命令总开关；false 时仅保留查询与目录命令（health / list_image_models /
# create_image_input / get_image_operation），generate_image / edit_image 会被拦截。
VIZ_DEVELOP_ENABLE_IMAGE=true

# 秒级命令超时（毫秒）：health / list_image_models / create_image_input / get_image_operation。
VIZ_DEVELOP_TIMEOUT_FAST_MS=30000

# submit 发起（握手与受理）超时上限（毫秒）；只管发起受理，不等待生图结果。
VIZ_DEVELOP_TIMEOUT_SLOW_MS=660000
