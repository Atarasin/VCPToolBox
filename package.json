    "eval:coverage": "node eval/vcp-eval.js suite list --coverage",
    "eval:tier1": "node eval/vcp-eval.js run --suite tier1",
    "eval:run": "node eval/vcp-eval.js run",
    "eval:score": "node eval/vcp-eval.js score latest",
    "eval:runs": "node eval/vcp-eval.js runs list",
    "eval:compare": "node eval/vcp-eval.js compare",
    "eval:gate": "node eval/vcp-eval.js gate"
